# Flash / PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# FreeRTOS tick rate — needed for LVGL timing
CONFIG_FREERTOS_HZ=1000

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# LCD / I80 parallel bus
CONFIG_LCD_PANEL_IO_FORMAT_BUF_SIZE=32768

# LVGL (if using esp-lvgl-port or idf-component-manager managed lvgl)
CONFIG_LV_MEM_SIZE_KILOBYTES=512
CONFIG_LV_DISP_DEF_REFR_PERIOD=16
CONFIG_LV_USE_GPU_ESP32S3_LX7=y

# Allow larger stack for LCD DMA task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
